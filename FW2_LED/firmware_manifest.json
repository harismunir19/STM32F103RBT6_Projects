{
    "schema_version": 1,
    "firmware_id": "stm32f103rbt6-fw2-led",
    "name": "STM32F103RBT6 FW2 LED Firmware",
    "version": "1.0.0",

    "target": {
        "mcu": "STM32F103RBT6",
        "architecture": "ARM Cortex-M3"
    },

    "build": {
        "tool": "STM32CubeIDE",
        "project_path": ".",
        "configuration": "Debug",
        "linker_script": "STM32F103RBTX_FLASH.ld"
    },

    "firmware": {
        "file": "artifacts/FW2_LED.bin",
        "format": "bin",
        "sha256": "3378A7F0AE67F0E47C6A7B941BC1C8B8AD8952AF8195F03097D4EB7EB8D7B451"
    },

    "flash": {
        "slot": "FW2",
        "start_address": "0x08012000",
        "end_address_exclusive": "0x08020000",
        "maximum_size": 57344
    },

    "bootloader": {
        "protocol": "STM32_UART_V1",
        "command": "V",
        "baudrate": 115200,
        "chunk_size": 128,
        "crc": "CRC32"
    }
}
