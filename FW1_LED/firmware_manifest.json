
{
    "schema_version": 1,
    "firmware_id": "stm32f103rbt6-fw1-led",
    "name": "STM32F103RBT6 FW1 LED Firmware",
    "version": "1.0.1",

    "target": {
        "mcu": "STM32F103RBT6",
        "architecture": "ARM Cortex-M3"
    },

    "build": {
        "tool": "STM32CubeIDE",
        "project_path": ".",
        "configuration": "Debug",
        "linker_script": "STM32F103RBTX_FLASH.ld"
    },

    "firmware": {
        "file": "artifacts/FW1_LED.bin",
        "format": "bin",
        "sha256": "300F1459BF77FCF0AE838A151EEC5686562D84932EB5224446CA57D8AD643104"
    },

    "flash": {
        "slot": "FW1",
        "start_address": "0x08004000",
        "end_address_exclusive": "0x08012000",
        "maximum_size": 57344
    },

    "bootloader": {
        "protocol": "STM32_UART_V1",
        "command": "U",
        "baudrate": 115200,
        "chunk_size": 128,
        "crc": "CRC32"
    }
}
